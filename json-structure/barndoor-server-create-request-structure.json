{
  "$schema": "https://json-structure.org/draft/2020-12/schema",
  "name": "ServerCreateRequest",
  "type": "object",
  "required": [
    "name",
    "mcp_server_directory_id"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "mcp_server_directory_id": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "client_id": {
      "type": "string"
    },
    "client_secret": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}